#!/bin/sh
# Host-light Open EPM release controller. Installation consumes only a release
# Compose file, immutable images and operator-supplied configuration/secrets.
set -eu
set -f

EX_USAGE=64
EX_UNAVAILABLE=69
EX_TEMPFAIL=75
EX_CONFIG=78

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Choose the packaged or source layout from the controller's location.
if [ -e "$script_dir/qualification-bundle-manifest.json" ]; then
    EPM_RELEASE_ASSETS_DIR=$script_dir/release-assets
else
    EPM_RELEASE_ASSETS_DIR=$script_dir/..
fi
export EPM_RELEASE_ASSETS_DIR
proxy_template=$EPM_RELEASE_ASSETS_DIR/proxy/openepm-base.yaml.template
compose_file=${EPM_RELEASE_COMPOSE_FILE:-"$script_dir/compose.yaml"}
identity_compose_file=${EPM_RELEASE_IDENTITY_COMPOSE_FILE:-"$script_dir/compose.identity.yaml"}
env_file=${EPM_RELEASE_ENV_FILE:-"$script_dir/openepm.env"}
release_manifest=${EPM_RELEASE_MANIFEST_FILE:-"$script_dir/release-manifest.json"}
release_manifest_signature=${EPM_RELEASE_MANIFEST_SIGNATURE_FILE:-"$script_dir/release-manifest.sig"}
release_inventory=${EPM_RELEASE_INVENTORY_FILE:-"$script_dir/release-inventory.json"}
signing_root=${EPM_SIGNING_OFFLINE_ROOT_FILE:-/etc/openepm/trust/offline-root-public.pem}
signing_policy=${EPM_SIGNING_TRUST_POLICY_FILE:-"$script_dir/signing-trust-policy.json"}
signing_policy_signature=${EPM_SIGNING_TRUST_POLICY_SIGNATURE_FILE:-"$script_dir/signing-trust-policy.sig"}
signing_sequence_state=${EPM_SIGNING_TRUST_SEQUENCE_STATE_FILE:-/var/lib/openepm/signing-trust-policy-sequence}
bootstrap_verifier="$script_dir/verify_openepm_release_bootstrap.py"
release_ingress_probe="$script_dir/openepm_release_ingress.py"
project_name=${EPM_RELEASE_PROJECT_NAME:-openepm}
sandbox_socket=${EPM_SANDBOX_CONTROL_SOCKET:-/run/openepm-sandbox/sandbox-launcher.sock}
maintenance_lock_dir=/run/openepm-release-maintenance
install_started_services=0
release_manifest_digest=
upgrade_candidate_manifest_digest=
upgrade_candidate_configuration_digest=
upgrade_proxy_routes_digest=
upgrade_source_daemon=
release_workspace_profile=0

usage() {
    printf '%s\n' 'usage: epmctl doctor|up|status|logs|stop|install|upgrade|backup|restore|activate-restored|renew-certificates --staging-dir DIR|uninstall' \
        '       epmctl status --diagnose|--json  Read-only component diagnosis. See ENTERPRISE_OPERATIONS_RUNBOOK.md in the release bundle.'
}

fail() {
    code=$1
    shift
    printf 'epmctl: %s\n' "$*" >&2
    exit "$code"
}

architecture() {
    machine=$(uname -m)
    case "$machine" in
        x86_64|amd64) printf '%s\n' amd64 ;;
        aarch64|arm64) printf '%s\n' arm64 ;;
        *) fail "$EX_CONFIG" "unsupported host architecture: $machine" ;;
    esac
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "$EX_CONFIG" "required command is unavailable: $1"
}

lock_release_maintenance() {
    require_command python3
    if [ ! -d "$maintenance_lock_dir" ]; then
        mkdir -m 0700 "$maintenance_lock_dir" 2>/dev/null || [ -d "$maintenance_lock_dir" ] ||
            fail "$EX_CONFIG" 'cannot create the protected host maintenance directory'
    fi
    [ -d "$maintenance_lock_dir" ] && [ -r "$maintenance_lock_dir" ] && [ ! -L "$maintenance_lock_dir" ] ||
        fail "$EX_CONFIG" 'host maintenance directory is unavailable or unsafe'

    # Lock the directory itself. The controller and its in-flight children
    # share the open description. There is no lock file to delete on recovery.
    exec 9< "$maintenance_lock_dir"
    lock_result=0
    python3 -B -c '
import errno, fcntl, os, stat, sys
try:
    opened = os.fstat(9)
    current = os.stat(sys.argv[1], follow_symlinks=False)
    if (not stat.S_ISDIR(opened.st_mode) or opened.st_uid != os.geteuid()
            or stat.S_IMODE(opened.st_mode) != 0o700 or not os.path.samestat(opened, current)):
        sys.exit(78)
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError as error:
    sys.exit(75 if error.errno in (errno.EACCES, errno.EAGAIN) else 69)
' "$maintenance_lock_dir" || lock_result=$?
    case "$lock_result" in
        0) ;;
        "$EX_TEMPFAIL") fail "$EX_TEMPFAIL" 'another release maintenance command is running on this host; inspect its outcome before retrying' ;;
        "$EX_CONFIG") fail "$EX_CONFIG" 'host maintenance directory must be owned by the controller user with mode 0700' ;;
        *) fail "$EX_UNAVAILABLE" 'could not verify the host maintenance lock' ;;
    esac
}

require_compose() {
    require_command docker
    docker info >/dev/null 2>&1 || fail "$EX_CONFIG" 'Docker daemon is unavailable'
    if docker compose version >/dev/null 2>&1; then
        compose_frontend=docker
    elif command -v docker-compose >/dev/null 2>&1 && docker-compose version >/dev/null 2>&1; then
        compose_frontend=docker-compose
    else
        fail "$EX_CONFIG" 'Docker Compose v2 is unavailable'
    fi
}

require_release_config() {
    [ -f "$compose_file" ] || fail "$EX_CONFIG" "release Compose file is unavailable: $compose_file"
    [ -f "$env_file" ] || fail "$EX_CONFIG" "release environment file is unavailable: $env_file"
    [ -r "$env_file" ] || fail "$EX_CONFIG" "release environment file is not readable: $env_file"
    if grep -Eq '^EPM_(NOTEBOOK|HUB)_' "$env_file"; then
        fail "$EX_CONFIG" 'retired Jupyter configuration must be removed before using this release'
    fi
    [ -f "$identity_compose_file" ] && [ -r "$identity_compose_file" ] ||
        fail "$EX_CONFIG" "bundled-identity Compose overlay is unavailable: $identity_compose_file"
    for asset in "$proxy_template" "$EPM_RELEASE_ASSETS_DIR/proxy/traefik.yaml" \
        "$EPM_RELEASE_ASSETS_DIR/operations/otel-collector.yaml"
    do
        [ -f "$asset" ] && [ -s "$asset" ] && [ -r "$asset" ] && [ ! -L "$asset" ] || \
            fail "$EX_CONFIG" "release configuration asset is unavailable, empty or symbolic: $asset"
    done
}

release_value() {
    sed -n "s/^${1}=//p" "$env_file"
}

inventory_field() {
    field=$1
    require_command python3
    python3 -c '
import json, sys
path, field = sys.argv[1:]
with open(path, encoding="utf-8") as stream:
    value = json.load(stream)
if value.get("format") != "openepm-release-inventory-v2":
    raise ValueError("unsupported release inventory")
profile = value["profile"]
items = profile[field]
if not isinstance(items, list) or not items or len(items) != len(set(items)):
    raise ValueError("invalid inventory field")
print(" ".join(items))
' "$release_inventory" "$field" 2>/dev/null ||
        fail "$EX_CONFIG" "release inventory field is invalid: $field"
}

keycloak_initial_subject() {
    result=$1
    prefix='{"format":"openepm-keycloak-bootstrap-result-v1","initialAdministratorSubject":"'
    suffix='"}'
    case "$result" in "$prefix"*"$suffix") ;; *) return 1 ;; esac
    subject=${result#"$prefix"}
    subject=${subject%"$suffix"}
    [ "$result" = "$prefix$subject$suffix" ] || return 1
    printf '%s\n' "$subject" | grep -Eq \
        '^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$' || return 1
    printf '%s\n' "$subject"
}

configured_identity_mode() {
    mode=$(release_value EPM_IDENTITY_MODE)
    case "$mode" in bundled) printf '%s\n' "$mode" ;;
        *) fail "$EX_CONFIG" 'EPM_IDENTITY_MODE must be bundled; external identity profiles are retired' ;;
    esac
}


configured_encryption_at_rest_mode() {
    mode=$(release_value EPM_ENCRYPTION_AT_REST_MODE)
    case "$mode" in
        deployment-volume) printf '%s\n' "$mode" ;;
        none) fail "$EX_CONFIG" 'EPM_ENCRYPTION_AT_REST_MODE=none is not permitted for production' ;;
        *) fail "$EX_CONFIG" 'EPM_ENCRYPTION_AT_REST_MODE must explicitly be deployment-volume or none' ;;
    esac
}

require_encrypted_persistent_volumes() {
    [ "$(configured_encryption_at_rest_mode)" = deployment-volume ] ||
        fail "$EX_CONFIG" 'deployment-volume encryption mode is required'
    require_command lsb_release
    require_command findmnt
    require_command lsblk
    require_command cryptsetup
    require_command dmsetup
    require_command realpath
    [ "$(lsb_release -is 2>/dev/null)" = Ubuntu ] ||
        fail "$EX_CONFIG" 'deployment-volume encryption verification requires an Ubuntu host'
    paths=$(release_value EPM_ENCRYPTED_VOLUME_PATHS)
    [ -n "$paths" ] || fail "$EX_CONFIG" 'EPM_ENCRYPTED_VOLUME_PATHS is required'
    docker_root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null) ||
        fail "$EX_CONFIG" 'Docker root directory is unavailable'
    backup_root=$(release_value EPM_BACKUP_EXPORT_DIR)
    required_roots="$docker_root $backup_root $(release_value EPM_SECRETS_DIR) $(release_value EPM_TLS_DIR) $(release_value EPM_PROXY_CONFIG_DIR)"
    for required in $required_roots; do
        case " $paths " in *" $required "*) ;;
            *) fail "$EX_CONFIG" "encrypted-volume inventory omits persistent path: $required" ;;
        esac
    done
    seen=''
    for path in $paths; do
        case "$path" in /*) ;; *) fail "$EX_CONFIG" 'encrypted-volume paths must be absolute' ;; esac
        case "$path" in *[!A-Za-z0-9_./-]*|*/../*|*/..)
            fail "$EX_CONFIG" "encrypted-volume path is not canonical and bounded: $path" ;;
        esac
        [ -d "$path" ] && [ ! -L "$path" ] ||
            fail "$EX_CONFIG" "encrypted-volume path is unavailable or symbolic: $path"
        [ "$(realpath -e -- "$path" 2>/dev/null)" = "$path" ] ||
            fail "$EX_CONFIG" "encrypted-volume path must be its canonical absolute path: $path"
        case " $seen " in *" $path "*) fail "$EX_CONFIG" "duplicate encrypted-volume path: $path" ;; esac
        seen="$seen $path"
        source=$(findmnt --noheadings --output SOURCE --target "$path" 2>/dev/null | tr -d ' ')
        case "$source" in /dev/mapper/*) ;; *)
            fail "$EX_CONFIG" "persistent path is not backed by an explicit dm-crypt mapper: $path" ;;
        esac
        [ "$(lsblk --noheadings --output TYPE "$source" 2>/dev/null | tr -d ' ')" = crypt ] ||
            fail "$EX_CONFIG" "persistent path backing device is not dm-crypt: $path"
        mapper=${source#/dev/mapper/}
        cryptsetup status "$mapper" 2>/dev/null | grep -Eq '^[[:space:]]*type:[[:space:]]*LUKS(1|2)?[[:space:]]*$' ||
            fail "$EX_CONFIG" "persistent path mapper is not an active LUKS device: $path"
        dmsetup table "$mapper" --target crypt 2>/dev/null | grep -q . ||
            fail "$EX_CONFIG" "persistent path mapper has no active dm-crypt target: $path"
    done
    printf 'encryption_at_rest=deployment-volume\nencrypted_volume_paths=%s\n' "$(printf '%s\n' "$paths" | wc -w | tr -d ' ')"
}

require_https_value() {
    key=$1
    value=$(release_value "$key")
    printf '%s\n' "$value" | grep -Eq \
        '^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?(/[^[:space:]@#]*)?$' ||
        fail "$EX_CONFIG" "$key must be an absolute credential-free HTTPS URL"
}

validate_mode_configuration() {
    identity_mode=$(configured_identity_mode)
    require_https_value EPM_OIDC_ISSUER
    require_https_value EPM_OIDC_JWKS_URL
    for key in EPM_OIDC_AUD_MCP EPM_OIDC_AUD_WEB; do
        value=$(release_value "$key")
        printf '%s\n' "$value" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$' ||
            fail "$EX_CONFIG" "$key must be a non-empty bounded audience identifier"
    done
    [ "$(release_value EPM_OIDC_AUD_MCP)" != "$(release_value EPM_OIDC_AUD_WEB)" ] ||
        fail "$EX_CONFIG" 'MCP and browser OIDC audiences must be distinct'
    identity_host=$(release_value EPM_IDENTITY_PUBLIC_HOST)
    printf '%s\n' "$identity_host" | grep -Eq '^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$' ||
        fail "$EX_CONFIG" 'EPM_IDENTITY_PUBLIC_HOST must be a lower-case DNS hostname'
    [ "$(release_value EPM_OIDC_ISSUER)" = "https://$identity_host/realms/openepm" ] ||
        fail "$EX_CONFIG" 'bundled EPM_OIDC_ISSUER must use the configured identity host and openepm realm'
    [ "$(release_value EPM_OIDC_JWKS_URL)" = \
      'https://identity:8443/realms/openepm/protocol/openid-connect/certs' ] ||
        fail "$EX_CONFIG" 'bundled EPM_OIDC_JWKS_URL must use the internal HTTPS identity endpoint'
    [ "$(release_value EPM_KEYCLOAK_DIRECTORY_URL)" = 'https://identity:8443' ] ||
        fail "$EX_CONFIG" 'bundled Keycloak directory must use the internal HTTPS identity endpoint'
    [ -z "$(release_value EPM_OIDC_ALLOW_INTERNAL_HTTP_JWKS)" ] ||
        fail "$EX_CONFIG" 'portable bundled identity does not allow cleartext JWKS transport'
    operator_issuer=$(release_value EPM_PLATFORM_OPERATOR_ISSUER)
    [ "$operator_issuer" = "$(release_value EPM_OIDC_ISSUER)" ] ||
        fail "$EX_CONFIG" 'platform operator issuer must equal the configured EPM OIDC issuer'
}

file_mode() {
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null
}

file_uid() {
    stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1" 2>/dev/null
}

require_sandbox_config() {
    secrets_dir=$(release_value EPM_SECRETS_DIR)
    [ -n "$secrets_dir" ] || fail "$EX_CONFIG" 'EPM_SECRETS_DIR is required'
    sandbox_profiles=${EPM_SANDBOX_PROFILES_FILE:-"$secrets_dir/epm_python_builder_profiles.json"}
    sandbox_key=${EPM_SANDBOX_CONTROL_KEY_FILE:-"$secrets_dir/epm_sandbox_control_key"}
    for path in "$sandbox_profiles" "$sandbox_key"; do
        [ -f "$path" ] && [ ! -L "$path" ] || fail "$EX_CONFIG" "sandbox configuration is unavailable or symbolic: $path"
        [ "$(file_uid "$path")" = 0 ] || fail "$EX_CONFIG" "sandbox configuration must be root-owned: $path"
    done
    case "$(file_mode "$sandbox_profiles")" in 400|440|444|600|640|644) ;; *) fail "$EX_CONFIG" 'sandbox profile permissions are too broad' ;; esac
    case "$(file_mode "$sandbox_key")" in 400|600) ;; *) fail "$EX_CONFIG" 'sandbox control-key permissions are too broad' ;; esac
    [ "$(wc -c < "$sandbox_key" | tr -d ' ')" -ge 32 ] || fail "$EX_CONFIG" 'sandbox control key is shorter than 32 bytes'
}

require_secret_files() {
    secrets_dir=$(release_value EPM_SECRETS_DIR)
    [ -d "$secrets_dir" ] && [ ! -L "$secrets_dir" ] ||
        fail "$EX_CONFIG" "secrets directory is unavailable or symbolic: $secrets_dir"
    for name in $(inventory_field secrets); do
        path=$secrets_dir/$name
        [ -f "$path" ] && [ ! -L "$path" ] ||
            fail "$EX_CONFIG" "required secret is unavailable or symbolic in release inventory: $path"
        [ "$(file_uid "$path")" = 0 ] || fail "$EX_CONFIG" "secret must be root-owned: $path"
        case "$(file_mode "$path")" in 400|440|600|640) ;;
            *) fail "$EX_CONFIG" "secret permissions are too broad: $path" ;; esac
        [ -s "$path" ] || fail "$EX_CONFIG" "required secret is empty: $path"
    done
}

validate_release_paths() {
    tls_dir=$(release_value EPM_TLS_DIR)
    proxy_dir=$(release_value EPM_PROXY_CONFIG_DIR)
    export_dir=$(release_value EPM_BACKUP_EXPORT_DIR)
    socket_dir=$(release_value EPM_SANDBOX_SOCKET_DIR)
    [ -n "$tls_dir" ] || fail "$EX_CONFIG" 'EPM_TLS_DIR is required'
    [ -n "$proxy_dir" ] || fail "$EX_CONFIG" 'EPM_PROXY_CONFIG_DIR is required'
    [ -n "$export_dir" ] || fail "$EX_CONFIG" 'EPM_BACKUP_EXPORT_DIR is required'
    [ -n "$socket_dir" ] || socket_dir=/run/openepm
    [ -d "$tls_dir" ] && [ ! -L "$tls_dir" ] ||
        fail "$EX_CONFIG" "TLS directory is unavailable or symbolic: $tls_dir"
    for certificate in tls.crt tls.key; do
        [ -f "$tls_dir/$certificate" ] && [ ! -L "$tls_dir/$certificate" ] ||
            fail "$EX_CONFIG" "TLS material is unavailable or symbolic: $tls_dir/$certificate"
    done
    [ ! -L "$export_dir" ] && [ ! -L "$socket_dir" ] && [ ! -L "$proxy_dir" ] ||
        fail "$EX_CONFIG" 'release data directories must not be symbolic links'
    public_host=$(release_value EPM_PUBLIC_HOST)
    printf '%s\n' "$public_host" | grep -Eq '^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$' ||
        fail "$EX_CONFIG" 'EPM_PUBLIC_HOST must be a lower-case DNS hostname'
    identity_host=$(release_value EPM_IDENTITY_PUBLIC_HOST)
    [ "$identity_host" != "$public_host" ] ||
        fail "$EX_CONFIG" 'application and identity public hostnames must be distinct'
}

prepare_backup_export_directory() {
    mkdir -p -m 0700 "$export_dir" ||
        fail "$EX_CONFIG" 'cannot prepare the backup export directory'
    [ ! -L "$export_dir" ] || fail "$EX_CONFIG" 'backup export directory must not be a symbolic link'
    # The backup/restore tooling runs as the fixed operations UID (10001) inside
    # its read-only container.  The export root must be writable by that UID, or
    # every backup/restore/upgrade fails on a clean install.
    chown 10001:10001 "$export_dir" ||
        fail "$EX_CONFIG" 'cannot assign the backup export directory to the operations service'
    chmod 0700 "$export_dir" ||
        fail "$EX_CONFIG" 'cannot protect the backup export directory'
}

prepare_runtime_directories() {
    mkdir -p -m 0700 "$socket_dir" ||
        fail "$EX_CONFIG" 'cannot prepare release socket directory'
    mkdir -p -m 0755 "$proxy_dir" ||
        fail "$EX_CONFIG" 'cannot prepare proxy configuration directory'
    [ ! -L "$socket_dir" ] && [ ! -L "$proxy_dir" ] ||
        fail "$EX_CONFIG" 'runtime directories must not be symbolic links'
    route_stage=$(mktemp "$proxy_dir/.openepm-route.XXXXXX") ||
        fail "$EX_CONFIG" 'cannot stage proxy route configuration'
    if ! sed -e "s/__EPM_PUBLIC_HOST__/$public_host/g" \
            -e "s/__EPM_IDENTITY_PUBLIC_HOST__/$identity_host/g" \
            "$proxy_template" > "$route_stage" || ! chmod 0644 "$route_stage"; then
        rm -f -- "$route_stage"
        fail "$EX_CONFIG" 'cannot render proxy route configuration'
    fi
    rendered_route_digest=
    if [ -n "$upgrade_candidate_configuration_digest" ]; then
        if ! rendered_route_digest=$(release_file_sha256 "$route_stage") || ! (verify_upgrade_candidate); then
            rm -f -- "$route_stage"
            fail "$EX_UNAVAILABLE" 'candidate configuration changed before publishing proxy routes'
        fi
    fi
    route_file=$proxy_dir/openepm-base.yaml
    if [ -d "$route_file" ] || ! mv -- "$route_stage" "$route_file"; then
        rm -f -- "$route_stage"
        fail "$EX_CONFIG" 'cannot publish proxy route configuration'
    fi
    upgrade_proxy_routes_digest=$rendered_route_digest
}

prepare_directories() {
    validate_release_paths
    prepare_backup_export_directory
    prepare_runtime_directories
}

require_launcher_active() {
    require_command systemctl
    systemctl is-active --quiet openepm-sandbox-launcher.service ||
        fail "$EX_UNAVAILABLE" 'trusted sandbox launcher service is not active'
    [ -S "$sandbox_socket" ] || fail "$EX_UNAVAILABLE" "trusted sandbox launcher socket is unavailable: $sandbox_socket"
}




require_no_external_sandboxes() {
    active_builds=$(docker ps -q --filter label=openepm.python-build=true 2>/dev/null) ||
        fail "$EX_UNAVAILABLE" 'cannot inspect active Python build sandboxes'
    [ -z "$active_builds" ] ||
        fail "$EX_CONFIG" 'restored activation requires all Python build sandboxes to finish or be cancelled'
}

validate_release_images() {
    keys="EPM_APPLICATION_IMAGE EPM_DATABASE_IMAGE EPM_OPERATIONS_IMAGE EPM_BUILDER_IMAGE EPM_PROXY_IMAGE EPM_BROWSER_GATEWAY_IMAGE EPM_BROWSER_SESSION_STORE_IMAGE EPM_IDENTITY_IMAGE EPM_OTEL_COLLECTOR_IMAGE"
    for key in $keys
    do
        value=$(sed -n "s/^${key}=//p" "$env_file")
        count=$(printf '%s\n' "$value" | sed '/^$/d' | wc -l | tr -d ' ')
        [ "$count" = 1 ] || fail "$EX_CONFIG" "$key must occur exactly once in the release environment"
        printf '%s\n' "$value" | grep -Eq '^[^@[:space:]]+@sha256:[a-f0-9]{64}$' ||
            fail "$EX_CONFIG" "$key must be an immutable image reference with a sha256 digest"
    done
}

release_trust_sequence() {
    python3 -B - "$signing_sequence_state" "$@" <<'PY'
import fcntl, os, stat, sys
from pathlib import Path
import re

path, action, raw_sequence = sys.argv[1:]
path = Path(path)

def parse_sequence(raw):
    if re.fullmatch(rb"[1-9][0-9]{0,4095}\n?", raw) is None:
        raise ValueError("invalid trust-policy sequence")
    return int(raw)

def stored_sequence(location, *, directory=None):
    try:
        descriptor = os.open(location, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=directory)
    except FileNotFoundError:
        return 0
    with os.fdopen(descriptor, "rb") as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError("invalid trust-policy sequence file")
        return parse_sequence(stream.read(4098))

def record_sequence(sequence):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o750)
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        # Lock the stable directory across the comparison and replacement.
        # A lock on the state file would stop protecting it after a rename.
        fcntl.flock(directory, fcntl.LOCK_EX)
        current = stored_sequence(path.name, directory=directory)
        if sequence < current:
            sys.exit(75)
        if sequence == current:
            # A prior process may have stopped after renaming the record.
            os.fsync(directory)
            return
        temporary = ".trust-sequence-" + os.urandom(12).hex()
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640,
                             dir_fd=directory)
        try:
            with os.fdopen(descriptor, "wb") as stream:
                os.fchmod(stream.fileno(), 0o640)
                stream.write(f"{sequence}\n".encode("ascii"))
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, path.name, src_dir_fd=directory, dst_dir_fd=directory)
            os.fsync(directory)
        finally:
            try:
                os.unlink(temporary, dir_fd=directory)
            except FileNotFoundError:
                pass
    finally:
        os.close(directory)

try:
    sequence = parse_sequence(raw_sequence.encode("ascii"))
    if action == "minimum":
        print(max(sequence, stored_sequence(path)))
    elif action == "record":
        record_sequence(sequence)
    elif action == "observe":
        if sequence < stored_sequence(path):
            sys.exit(75)
    else:
        sys.exit(64)
except (OSError, ValueError):
    sys.exit(78)
PY
}

validate_release_manifest() {
    manifest_validation_mode=${1:-record}
    case "$manifest_validation_mode" in record|observe) ;; *) fail "$EX_USAGE" 'invalid internal manifest validation mode' ;; esac
    [ -f "$release_manifest" ] && [ -r "$release_manifest" ] ||
        fail "$EX_CONFIG" "release manifest is unavailable: $release_manifest"
    if [ -z "$release_manifest_digest" ]; then
        release_manifest_digest=$(release_manifest_sha256) || exit "$?"
    fi
    for trust_file in "$release_manifest_signature" "$signing_root" "$signing_policy" "$signing_policy_signature" "$bootstrap_verifier"; do
        [ -f "$trust_file" ] && [ -r "$trust_file" ] && [ ! -L "$trust_file" ] ||
            fail "$EX_CONFIG" "release trust material is unavailable or symbolic: $trust_file"
    done
    [ -f "$release_inventory" ] && [ -r "$release_inventory" ] && [ ! -L "$release_inventory" ] ||
        fail "$EX_CONFIG" "release inventory is unavailable or symbolic: $release_inventory"
    operations_image=$(release_value EPM_OPERATIONS_IMAGE)
    bundle_dir=$(CDPATH= cd -- "$(dirname -- "$release_manifest")" && pwd)
    signing_policy_dir=$(CDPATH= cd -- "$(dirname -- "$signing_policy")" && pwd)
    signing_policy_name=$(basename -- "$signing_policy")
    manifest_name=$(basename -- "$release_manifest")
    env_dir=$(CDPATH= cd -- "$(dirname -- "$env_file")" && pwd)
    [ "$bundle_dir" = "$env_dir" ] ||
        fail "$EX_CONFIG" 'release manifest and environment must share one immutable bundle directory'
    host_arch=linux/$(architecture)
    # Establish publisher trust and the verifier image identity on the host
    # before executing any code supplied by that image.  The full verifier
    # still performs the complete artifact/evidence contract below.
    require_command python3
    configured_minimum=${EPM_MINIMUM_TRUST_POLICY_SEQUENCE:-}
    case "$configured_minimum" in
        ''|0*|*[!0-9]*) fail "$EX_CONFIG" 'EPM_MINIMUM_TRUST_POLICY_SEQUENCE must be supplied by the approved release channel' ;;
    esac
    minimum_sequence=$(release_trust_sequence minimum "$configured_minimum") ||
        fail "$EX_CONFIG" 'configured or stored trust-policy sequence is unavailable, invalid or symbolic'
    authenticated_sequence=$(python3 "$bootstrap_verifier" \
        --manifest "$release_manifest" \
        --expected-manifest-sha256 "$release_manifest_digest" \
        --manifest-signature "$release_manifest_signature" \
        --inventory "$release_inventory" \
        --architecture "$host_arch" \
        --selected-operations "$operations_image" \
        --trusted-root-public-key "$signing_root" \
        --trust-policy "$signing_policy" \
        --trust-policy-signature "$signing_policy_signature" \
        --minimum-trust-policy-sequence "$minimum_sequence" 2>/dev/null) ||
        fail "$EX_CONFIG" 'host release bootstrap verification failed'
    case "$authenticated_sequence" in
        ''|0*|*[!0-9]*) fail "$EX_CONFIG" 'host release bootstrap returned an invalid policy sequence' ;;
    esac
    verification_result=0
    (
        if [ "$manifest_validation_mode" = observe ]; then
            set -- --pull=never
            exec 2>/dev/null
        else
            set --
        fi
        docker run --rm --read-only --network none --user 10001:10001 \
            -v "$bundle_dir:/release:ro" \
            -v "$release_manifest_signature:/run/openepm-trust/release-manifest.sig:ro" \
            -v "$signing_root:/run/openepm-trust/offline-root-public.pem:ro" \
            -v "$signing_policy_dir:/run/openepm-trust/policy:ro" \
            -v "$signing_policy_signature:/run/openepm-trust/signing-trust-policy.sig:ro" \
            "$@" "$operations_image" \
            python -m scripts.validate_release_manifest \
            --manifest "/release/$manifest_name" \
            --expected-manifest-sha256 "$release_manifest_digest" \
            --environment "/release/$(basename -- "$env_file")" \
            --host-architecture "$host_arch" \
            --manifest-signature /run/openepm-trust/release-manifest.sig \
            --trusted-root-public-key /run/openepm-trust/offline-root-public.pem \
            --trust-policy "/run/openepm-trust/policy/$signing_policy_name" \
            --trust-policy-signature /run/openepm-trust/signing-trust-policy.sig \
            --minimum-trust-policy-sequence "$minimum_sequence" >/dev/null
    ) || verification_result=$?
    case "$manifest_validation_mode:$verification_result" in
        *:0) ;;
        observe:125|observe:126|observe:127)
            fail "$EX_UNAVAILABLE" 'Docker could not run the local release verifier. Check the installed operations image and Docker daemon, then rerun diagnosis.' ;;
        *) fail "$EX_CONFIG" 'release manifest validation failed' ;;
    esac
    # Diagnosis also rechecks the current floor without publishing state.
    trust_sequence_result=0
    release_trust_sequence "$manifest_validation_mode" "$authenticated_sequence" || trust_sequence_result=$?
    case "$trust_sequence_result" in
        0) ;;
        "$EX_TEMPFAIL") fail "$EX_CONFIG" 'trust-policy sequence advanced during release verification; retry with the current signed policy' ;;
        *) fail "$EX_CONFIG" 'authenticated trust-policy sequence could not be confirmed' ;;
    esac
}

configure_release_compose() {
    if [ "$1" = observe ]; then
        require_command docker
        compose_frontend=$(python3 -B "$script_dir/openepm_release_status.py" --probe-compose-frontend) ||
            exit "$EX_UNAVAILABLE"
    else
        require_compose
    fi
    require_release_config
    validate_mode_configuration
    validate_release_images
    validate_release_manifest "$1"
    configured_identity_mode >/dev/null
}

execute_release_compose() {
    if [ "$compose_frontend" = docker ]; then
        docker compose --project-name "$project_name" --env-file "$env_file" -f "$compose_file" -f "$identity_compose_file" "$@"
        return
    fi
    docker-compose --project-name "$project_name" --env-file "$env_file" -f "$compose_file" -f "$identity_compose_file" "$@"
}

verify_upgrade_candidate() {
    if [ -n "$upgrade_candidate_manifest_digest" ] &&
        [ "$(release_manifest_sha256)" != "$upgrade_candidate_manifest_digest" ]; then
        fail "$EX_UNAVAILABLE" 'candidate release manifest changed during upgrade; inspect the release and upgrade evidence'
    fi
    if [ -n "$upgrade_candidate_configuration_digest" ]; then
        observe_upgrade_candidate_configuration \
            --expected-configuration-sha256 "$upgrade_candidate_configuration_digest" >/dev/null ||
            fail "$EX_UNAVAILABLE" 'candidate Compose verification failed during upgrade; inspect the release and upgrade evidence'
    fi
}

pin_upgrade_docker_context() {
    # Keep an explicit Docker context or daemon endpoint selected by the operator.
    if [ -n "${DOCKER_CONTEXT:-}${DOCKER_HOST:-}" ]; then return 0; fi
    require_command docker
    selected_context=$(docker context show) ||
        fail "$EX_UNAVAILABLE" 'upgrade could not determine the selected Docker context'
    case "$selected_context" in
        ''|*[!a-zA-Z0-9._-]*) fail "$EX_UNAVAILABLE" 'upgrade Docker context is invalid' ;;
    esac
    export DOCKER_CONTEXT="$selected_context"
}

verify_upgrade_daemon() {
    [ -z "$upgrade_source_daemon" ] ||
        observe_release_project --expected-docker-daemon "$upgrade_source_daemon" ||
        fail "$EX_UNAVAILABLE" 'upgrade could not confirm the original Docker daemon'
}

compose_call() {
    verify_upgrade_daemon
    configure_release_compose record
    verify_upgrade_candidate
    verify_upgrade_daemon
    execute_release_compose "$@"
}

compose_project_call() {
    target_project=$1
    shift
    require_compose
    require_release_config
    validate_mode_configuration
    validate_release_images
    configured_identity_mode >/dev/null
    if [ "$compose_frontend" = docker ]; then
        docker compose --project-name "$target_project" --env-file "$env_file" -f "$compose_file" -f "$identity_compose_file" "$@"
        return
    fi
    docker-compose --project-name "$target_project" --env-file "$env_file" -f "$compose_file" -f "$identity_compose_file" "$@"
}

compose() {
    compose_call "$@"
}

install_failed() {
    message=$1
    if [ "$install_started_services" = 1 ]; then
        compose_call stop >/dev/null 2>&1 || true
        printf '%s\n' 'epmctl: newly started services were stopped; persistent volumes were preserved' >&2
    else
        printf '%s\n' 'epmctl: an existing running stack was left unchanged' >&2
    fi
    fail "$EX_UNAVAILABLE" "$message"
}

operations_run() {
    if [ -n "$upgrade_candidate_manifest_digest" ]; then
        # The release observer owns the set of services allowed during upgrade.
        # A one-shot helper must not restart its stopped Compose dependencies.
        compose_call --profile operations run --no-deps --rm -T operations "$@"
        return
    fi
    compose_call --profile operations run --rm -T operations "$@"
}

require_release_tool() {
    tool=$1
    operations_run test -x "/usr/local/bin/$tool" >/dev/null 2>&1 ||
        fail "$EX_UNAVAILABLE" "operations image does not contain the qualified $tool tool"
}

validate_browser_gateway_configuration() {
    issuer=$(release_value EPM_OIDC_ISSUER)
    web_origin=https://$(release_value EPM_PUBLIC_HOST)
    operations_run python -m scripts.validate_release_manifest --browser-gateway \
        --issuer "$issuer" --web-origin "$web_origin" ||
        fail "$EX_CONFIG" 'browser gateway/session configuration differs from the fixed release contract'
}

valid_bundle_name() {
    case "$1" in *[!a-zA-Z0-9-]*|'') return 1 ;; esac
    printf '%s\n' "$1" | grep -Eq '^openepm-base-[0-9]{8}T[0-9]{6}Z-[0-9]+$'
}

restore_marker_path() {
    bundle=$1
    target=$2
    printf '%s/.%s.%s.restore-ready\n' \
        "$(release_value EPM_BACKUP_EXPORT_DIR)" "$bundle" "$target"
}

release_file_sha256() {
    require_command sha256sum
    digest=$(sha256sum < "$1") || return 1
    printf '%s\n' "${digest%% *}"
}

release_manifest_sha256() {
    release_file_sha256 "$release_manifest" ||
        fail "$EX_UNAVAILABLE" 'cannot digest the release manifest'
}

restore_marker_content() {
    bundle=$1
    target=$2
    identity_mode=$(configured_identity_mode)
    printf '%s\n' \
        'format=openepm-restored-target-v3' \
        "bundle=$bundle" \
        "target_project=$target" \
        "prior_project=$project_name" \
        "release_manifest_sha256=$restore_release_manifest_digest" \
        "identity_mode=$identity_mode"
}

process_restore_target() {
    marker=$(restore_marker_path "$bundle" "$target")
    [ -r "$script_dir/openepm_release_restore_target.py" ] ||
        fail "$EX_CONFIG" 'restore target verifier is unavailable in the release bundle'
    marker_content=$(restore_marker_content "$bundle" "$target") ||
        fail "$EX_UNAVAILABLE" 'cannot prepare restore-ready identity'
    python3 -B "$script_dir/openepm_release_restore_target.py" \
        --inventory "$release_inventory" --candidate-manifest "$release_manifest" \
        --verified-manifest-sha256 "$restore_release_manifest_digest" \
        --host-architecture "linux/$(architecture)" \
        --compose-frontend "$compose_frontend" --project "$target" \
        --env-file "$env_file" --compose-file "$compose_file" \
        --identity-compose-file "$identity_compose_file" --bundle "$bundle" \
        --expected-backup-manifest-sha256 "${EPM_RESTORE_EXPECTED_BACKUP_MANIFEST_SHA256:-}" \
        --marker "$marker" --marker-content "$marker_content" "$@"
}

project_profiles() {
    configured_identity_mode >/dev/null
    first=1
    for profile in $(inventory_field composeProfiles); do
        [ "$first" = 1 ] || printf ' '
        printf '%s %s' '--profile' "$profile"
        first=0
    done
    if [ "$release_workspace_profile" = 1 ]; then
        printf ' --profile workspace'
    fi
    printf '\n'
}

project_services() {
    configured_identity_mode >/dev/null
    inventory_field services
    if [ "$release_workspace_profile" = 1 ]; then
        printf '%s\n' workspace
    fi
}

upgrade_mutable_services() {
    for service in $upgrade_services; do
        case "$service" in db|control-db|identity) ;;
            *) printf '%s\n' "$service" ;;
        esac
    done
}

observe_project_state() {
    observed_project=$1
    shift
    [ -r "$script_dir/openepm_release_upgrade.py" ] ||
        fail "$EX_CONFIG" 'packaged upgrade project observer is unavailable'
    python3 -B "$script_dir/openepm_release_upgrade.py" \
        --inventory "$release_inventory" --project="$observed_project" \
        --workspace-id="$release_workspace_id" "$@"
}

observe_release_project() {
    observe_project_state "$project_name" "$@"
}

observe_upgrade_candidate_configuration() {
    if [ -n "$upgrade_proxy_routes_digest" ]; then
        set -- "$@" --expected-proxy-routes-sha256 "$upgrade_proxy_routes_digest"
    fi
    python3 -B "$script_dir/openepm_release_upgrade.py" \
        --inventory "$release_inventory" --project "$project_name" \
        --candidate-manifest "$release_manifest" \
        --verified-manifest-sha256 "$upgrade_candidate_manifest_digest" \
        --host-architecture "linux/$(architecture)" --compose-frontend "$compose_frontend" \
        --env-file "$env_file" --compose-file "$compose_file" \
        --identity-compose-file "$identity_compose_file" \
        --proxy-routes-file "$proxy_dir/openepm-base.yaml" "$@"
}

observe_upgraded_runtime() {
    stage=$1
    shift
    observe_upgrade_candidate_configuration \
        --expected-configuration-sha256 "$upgrade_candidate_configuration_digest" \
        --verify-running-from "$upgrade_source" --activation-stage "$stage" "$@"
}

inspect_upgrade_schema() {
    ledger=$(operations_run /usr/local/bin/openepm-release-upgrade-preflight \
        --target-migration "$upgrade_target_migration" --bind-database "$@") || return 1
    printf '%s' "$ledger" | python3 -B -c '
import re, sys
value = sys.stdin.read(256)
if re.fullmatch(r"[0-9]{4} [a-f0-9]{64} [a-f0-9]{64}", value) is None:
    sys.exit(1)
print(value)
'
}

pull_release_images() {
    # Profiles come from the same authority used to start current and restored
    # releases.  Operations is one-shot and therefore added only for pulling.
    # shellcheck disable=SC2046
    compose_call $(project_profiles) --profile operations pull
}

verify_release_health_boundaries() {
    # Keep process reachability, dependency readiness and authentication
    # denial as distinct evidence.  A response from a live listener is not
    # sufficient readiness, and readiness must not stand in for the explicit
    # unsigned-access security assertion.
    compose_call exec -T platform python -m scripts.check_postgres_mcp_health liveness ||
        return 1
    compose_call exec -T platform python -m scripts.check_postgres_mcp_health readiness ||
        return 2
    compose_call exec -T platform python -m scripts.check_postgres_mcp_health unsigned-denial ||
        return 3
}

require_release_ingress_probe() {
    [ -f "$release_ingress_probe" ] && [ -r "$release_ingress_probe" ] ||
        fail "$EX_CONFIG" 'public ingress verifier is unavailable in the release bundle'
}

verify_release_public_ingress() {
    binding=$(compose_project_call "$1" port proxy 443) ||
        fail "$EX_UNAVAILABLE" 'candidate public HTTPS port could not be observed'
    python3 -B "$release_ingress_probe" --binding "$binding" --profile "$2" \
        --host "$(release_value EPM_PUBLIC_HOST)" --issuer "$(release_value EPM_OIDC_ISSUER)" \
        --certificate "$(release_value EPM_TLS_DIR)/tls.crt"
}

start_current_release() {
    # Values are produced only from fixed functions, never caller text.
    # shellcheck disable=SC2046
    compose_call $(project_profiles) up -d --wait --wait-timeout 300 \
        $(project_services)
}

internal_activation_services() {
    for service do
        case "$service" in proxy|worker) ;; *) printf '%s\n' "$service" ;; esac
    done
}

start_upgrade_internal_services() {
    # shellcheck disable=SC2046
    compose_call $(project_profiles) up -d --wait --wait-timeout 300 \
        $(internal_activation_services $upgrade_services)
}

start_upgrade_service() {
    # No implicit restart or recreation of previously verified dependencies.
    # shellcheck disable=SC2046
    compose_call $(project_profiles) up -d --wait --wait-timeout 300 --no-deps "$1"
}

pause_failed_upgrade() {
    trap - HUP INT TERM
    message=$1
    # The candidate configuration may be the cause of the failure. Use the
    # local project inventory and exact Docker identities to pause it.
    # shellcheck disable=SC2086
    observe_release_project --pause-candidate $upgrade_services \
        --expected-docker-daemon "$upgrade_source_daemon" ||
        fail "$EX_UNAVAILABLE" "$message; could not verify that candidate workloads stopped; manual recovery required"
    fail "$EX_UNAVAILABLE" "$message; candidate workloads stopped; inspect the migration and backup evidence before recovery"
}

restored_internal_services() {
    for service in $(internal_activation_services $restore_services); do
        case "$service" in db|control-db) ;;
            *) printf '%s\n' "$service" ;;
        esac
    done
}

start_target_release() {
    # shellcheck disable=SC2046
    printf '%s\n' "$activation_overlay" | compose_project_call "$target" -f - \
        $(project_profiles) up -d --wait --wait-timeout 300 --no-deps "$@"
}

rollback_restored_activation() {
    trap - HUP INT TERM
    message=$1
    # Use exact target identities even if the effective Compose model changed.
    # shellcheck disable=SC2086
    (observe_project_state "$target" --pause-candidate $restore_services --pause-restored-target \
        --expected-docker-daemon "$restore_daemon") ||
        fail "$EX_UNAVAILABLE" "$message and target services could not be confirmed stopped; manual recovery required"
    printf '%s\n' "$restore_prior" | observe_release_project --restart-prior-release ||
        fail "$EX_UNAVAILABLE" "$message and exact prior-release restart failed; manual recovery required"
    fail "$EX_UNAVAILABLE" "$message; prior release was restarted from its captured containers"
}

create_backup_bundle() {
    backup_export=$1
    shift
    # The marker prevents the container utility from mistaking an anonymous
    # or internal path for the operator's independently mounted destination.
    marker=$backup_export/.openepm-host-visible
    : > "$marker" || fail "$EX_CONFIG" 'cannot prepare the backup export destination'
    chmod 0600 "$marker" || fail "$EX_CONFIG" 'cannot protect the backup export marker'
    require_release_tool openepm-release-backup
    output=$(operations_run /usr/local/bin/openepm-release-backup "$@") ||
        fail "$EX_UNAVAILABLE" 'verified backup/export failed; no complete bundle was reported'
    bundle=${output#bundle=}
    if [ "${1:-}" = --report-manifest-sha256 ]; then
        bundle=${bundle%% *}
        reported_digest=${output#bundle="$bundle" manifest_sha256=}
        case "$reported_digest" in
            ''|*[!0-9a-f]*) fail "$EX_UNAVAILABLE" 'backup tool did not report the published manifest digest' ;;
        esac
        [ "${#reported_digest}" = 64 ] ||
            fail "$EX_UNAVAILABLE" 'backup tool did not report the published manifest digest'
    fi
    [ "$bundle" != "$output" ] && valid_bundle_name "$bundle" ||
        fail "$EX_UNAVAILABLE" 'backup tool did not return a valid completed bundle identity'
    [ -d "$backup_export/$bundle" ] && [ ! -L "$backup_export/$bundle" ] ||
        fail "$EX_UNAVAILABLE" 'backup bundle is not visible at the independent export destination'
    if [ "${1:-}" = --report-manifest-sha256 ]; then
        printf '%s %s\n' "$bundle" "$reported_digest"
    else
        printf '%s\n' "$bundle"
    fi
}

backup_release() {
    doctor_local
    require_secret_files
    validate_release_paths
    prepare_backup_export_directory
    bundle=$(create_backup_bundle "$export_dir") || exit "$?"
    printf 'backup=complete\nbundle=%s\nsource_project=%s\n' "$bundle" "$project_name"
}

restore_release() {
    [ "$#" -eq 1 ] || fail "$EX_USAGE" 'restore requires exactly one recovery bundle name'
    bundle=$1
    valid_bundle_name "$bundle" || fail "$EX_USAGE" 'restore bundle name is invalid'
    target=${EPM_RESTORE_TARGET_PROJECT:-}
    [ -n "$target" ] || fail "$EX_CONFIG" 'EPM_RESTORE_TARGET_PROJECT is required'
    case "$target" in *[!a-z0-9_-]*|'') fail "$EX_CONFIG" 'restore target project name is invalid' ;; esac
    [ "$target" != "$project_name" ] ||
        fail "$EX_CONFIG" 'restore refuses to target the active source project'
    lock_release_maintenance
    doctor_local
    restore_release_manifest_digest=$release_manifest_digest
    require_secret_files
    # The target stages its recovered configuration under the export directory.
    # The serving release's runtime paths and existing export permissions stay in use.
    validate_release_paths
    [ -d "$export_dir/$bundle" ] ||
        fail "$EX_CONFIG" 'requested recovery bundle is unavailable'
    [ -f "$export_dir/.openepm-host-visible" ] ||
        fail "$EX_CONFIG" 'backup export destination is not operator-marked'
    marker=$(restore_marker_path "$bundle" "$target")
    [ ! -e "$marker" ] && [ ! -L "$marker" ] ||
        fail "$EX_CONFIG" 'restore-ready marker already exists'
    restored_backup_manifest=$(process_restore_target) || exit "$?"
    printf 'restore=verified\nbundle=%s\ntarget_project=%s\nsource_project=%s\nrestored_config=%s\nbackup_manifest_sha256=%s\n' \
        "$bundle" "$target" "$project_name" "${marker%.restore-ready}.recovered-config/restore" "$restored_backup_manifest"
}

activate_restored_release() {
    [ "$#" -eq 1 ] || fail "$EX_USAGE" 'activate-restored requires exactly one recovery bundle name'
    bundle=$1
    valid_bundle_name "$bundle" || fail "$EX_USAGE" 'activate-restored bundle name is invalid'
    target=${EPM_RESTORE_TARGET_PROJECT:-}
    case "$target" in *[!a-z0-9_-]*|'') fail "$EX_CONFIG" 'restore target project name is invalid' ;; esac
    [ "$target" != "$project_name" ] || fail "$EX_CONFIG" 'restored target must differ from prior project'
    lock_release_maintenance
    doctor_local
    restore_release_manifest_digest=$release_manifest_digest
    require_secret_files
    require_release_ingress_probe
    require_no_external_sandboxes
    release_workspace_id=$(release_value EPM_PG_WORKSPACE_ID)
    restored_from=$(observe_release_project --capture-prior-release) || exit "$?"
    restore_profile=${restored_from%% *}
    restore_prior=${restored_from#* }
    restore_daemon=${restore_prior%% *}
    restore_prior=${restore_prior#* }
    if [ "$restore_profile" = workspace ]; then
        export EPM_PG_WORKSPACE_ID="$release_workspace_id"
        release_workspace_profile=1
    fi
    restore_services=$(project_services) || exit "$?"
    marker=$(restore_marker_path "$bundle" "$target")
    activated=${marker%.restore-ready}.activated
    [ ! -e "$activated" ] && [ ! -L "$activated" ] ||
        fail "$EX_CONFIG" 'restored activation marker already exists'
    activation_overlay=$(process_restore_target --activation-profile "$restore_profile" --check-activation before) || exit "$?"

    trap 'rollback_restored_activation "restored activation interrupted"' HUP INT TERM
    printf '%s\n' "$restore_prior" | observe_release_project --pause-prior-release ||
        rollback_restored_activation 'cannot confirm the exact prior release paused for restored activation'
    # shellcheck disable=SC2046
    (start_target_release $(restored_internal_services)) || rollback_restored_activation 'restored internal activation failed'
    internal_runtime=$(process_restore_target --activation-profile "$restore_profile" \
        --check-activation started --activation-stage internal) ||
        rollback_restored_activation 'restored serving identity check failed before health'
    (compose_project_call "$target" exec -T platform python -m scripts.check_postgres_mcp_health) ||
        rollback_restored_activation 'restored health check failed'
    process_restore_target --activation-profile "$restore_profile" --check-activation after \
        --activation-stage internal --expected-running-sha256 "$internal_runtime" --check-browser-gateway >/dev/null ||
        rollback_restored_activation 'restored database or serving identity check failed after health'
    (start_target_release worker) || rollback_restored_activation 'restored worker activation failed'
    restored_worker_runtime=$(process_restore_target --activation-profile "$restore_profile" \
        --check-activation started --activation-stage worker --expected-previous-running-sha256 "$internal_runtime") ||
        rollback_restored_activation 'restored worker or verified internal runtime could not be verified'
    (start_target_release proxy) || rollback_restored_activation 'restored proxy activation failed'
    restored_runtime=$(process_restore_target --activation-profile "$restore_profile" \
        --check-activation started --activation-stage serving --expected-previous-running-sha256 "$restored_worker_runtime") ||
        rollback_restored_activation 'restored public runtime could not be verified'
    (verify_release_public_ingress "$target" "$restore_profile") ||
        rollback_restored_activation 'restored public ingress could not be verified'
    activated_backup_manifest=$(process_restore_target --activation-profile "$restore_profile" --check-activation after \
        --activation-stage serving --expected-running-sha256 "$restored_runtime") ||
        rollback_restored_activation 'restored public runtime changed before activation publication'
    # Keep marker publication and the end of the rollback window together.
    trap '' HUP INT TERM
    mv "$marker" "$activated" || rollback_restored_activation 'activation-marker publication failed'
    trap - HUP INT TERM
    printf 'activation=verified\nbundle=%s\ntarget_project=%s\nprior_project=%s\nactivated_runtime_sha256=%s\nbackup_manifest_sha256=%s\n' \
        "$bundle" "$target" "$project_name" "$restored_runtime" "$activated_backup_manifest"
}

upgrade_release() {
    pin_upgrade_docker_context
    doctor
    require_launcher_active
    require_secret_files
    require_release_ingress_probe
    validate_release_paths
    upgrade_candidate_manifest_digest=$release_manifest_digest
    upgrade_target_migration=$(python3 -B -c '
import hashlib, json, re, sys
from pathlib import Path
payload = Path(sys.argv[1]).read_bytes()
target = json.loads(payload).get("schemaMigration")
if (hashlib.sha256(payload).hexdigest() != sys.argv[2] or
        not isinstance(target, str) or re.fullmatch(r"[0-9]{4}_[a-z0-9_]+\.sql", target) is None):
    sys.exit(1)
print(target)
' "$release_manifest" "$upgrade_candidate_manifest_digest" 2>/dev/null) ||
        fail "$EX_CONFIG" 'candidate release does not identify an exact target migration'
    release_workspace_id=$(release_value EPM_PG_WORKSPACE_ID)
    upgrade_source=$(observe_release_project) || exit "$?"
    # All seven fields come from the bounded local upgrade observer.
    set -- $upgrade_source
    source_runtime_digest=$5
    database_volume_digest=$6
    upgrade_source_daemon=$7
    case "$upgrade_source" in
        'workspace '*)
            export EPM_PG_WORKSPACE_ID="$release_workspace_id"
            release_workspace_profile=1
            ;;
    esac
    upgrade_candidate_configuration_digest=$(observe_upgrade_candidate_configuration) || exit "$?"
    upgrade_services=$(project_services) || exit "$?"
    require_release_tool openepm-release-upgrade-preflight
    source_database_cut=$(inspect_upgrade_schema) ||
        fail "$EX_UNAVAILABLE" 'upgrade compatibility preflight failed'
    source_ledger=${source_database_cut% *}
    source_database_digest=${source_database_cut##* }
    # Stop every inventory-defined request, publication and mutable
    # service before changing schema.  Database and identity services remain
    # available for the bounded migration/control operations below.
    # shellcheck disable=SC2046
    compose_call $(project_profiles) stop $(upgrade_mutable_services) ||
        fail "$EX_UNAVAILABLE" 'upgrade could not quiesce mutable services'
    # Initial preflight can race producers while they are still running.
    # Verify the stopped cut before creating its independent recovery bundle.
    stopped_database_cut=$(inspect_upgrade_schema) ||
        fail "$EX_UNAVAILABLE" 'upgrade preflight failed after quiescence; inspect the existing release before migration'
    [ "$source_database_digest" = "${stopped_database_cut##* }" ] ||
        fail "$EX_UNAVAILABLE" 'source application database changed during quiescence; inspect the existing release'
    [ "$source_ledger" = "${stopped_database_cut% *}" ] ||
        fail "$EX_UNAVAILABLE" 'source migration ledger changed during quiescence; inspect the existing release'
    observe_release_project --quiescent-from "$upgrade_source" || exit "$?"
    prepare_backup_export_directory
    recovery_identity=$(create_backup_bundle "$export_dir" --report-manifest-sha256 \
        --expected-source-database "$source_database_digest") ||
        fail "$EX_UNAVAILABLE" 'pre-upgrade backup failed after quiescence'
    recovery_bundle=${recovery_identity%% *}
    recovery_manifest_digest=${recovery_identity#* }
    recovery_manifest=$export_dir/$recovery_bundle/manifest.json
    [ -f "$recovery_manifest" ] && [ ! -L "$recovery_manifest" ] && [ -s "$recovery_manifest" ] ||
        fail "$EX_UNAVAILABLE" 'pre-upgrade backup manifest is missing, empty or symbolic'
    visible_manifest_digest=$(release_file_sha256 "$recovery_manifest") ||
        fail "$EX_UNAVAILABLE" 'cannot digest the pre-upgrade backup manifest'
    [ "$visible_manifest_digest" = "$recovery_manifest_digest" ] ||
        fail "$EX_UNAVAILABLE" 'published backup manifest differs from the pre-upgrade backup receipt'
    # Publish the exact export before any migration so a later failure still
    # leaves an actionable reference in the maintenance transcript.
    printf '%s\n' "pre_upgrade_backup_bundle=$recovery_bundle" \
        "pre_upgrade_backup_manifest_sha256=$recovery_manifest_digest" \
        "candidate_release_manifest_sha256=$upgrade_candidate_manifest_digest" \
        "candidate_effective_compose_sha256=$upgrade_candidate_configuration_digest" \
        "source_project=$project_name" \
        "source_docker_daemon=$upgrade_source_daemon" \
        "source_runtime_sha256=$source_runtime_digest" \
        "source_database_volumes_sha256=$database_volume_digest" \
        "source_application_database_sha256=$source_database_digest" \
        "source_schema_version=${source_ledger%% *}" \
        "source_migration_chain_sha256=${source_ledger#* }" \
        "candidate_schema_migration=$upgrade_target_migration"
    pull_release_images || fail "$EX_UNAVAILABLE" 'upgrade image pull failed'
    validate_browser_gateway_configuration
    operations_run /usr/local/bin/openepm-release-backup --verify-bundle "$recovery_bundle" \
        --expected-manifest-sha256 "$recovery_manifest_digest" \
        --expected-source-schema "${source_ledger%% *}" ||
        fail "$EX_UNAVAILABLE" 'pre-upgrade backup authentication failed; no database bootstrap or migration was started'
    observe_release_project --quiescent-from "$upgrade_source" || exit "$?"
    # The protected configuration in the recovery bundle belongs to the source release.
    prepare_runtime_directories
    compose_call --profile operations run --rm -T control-bootstrap ||
        fail "$EX_UNAVAILABLE" 'isolated control-plane database bootstrap failed'
    compose_call --profile bundled-identity up -d --wait --wait-timeout 300 identity ||
        fail "$EX_UNAVAILABLE" 'bundled identity service did not become healthy'
    compose_call --profile bundled-identity run --rm -T keycloak-bootstrap ||
        fail "$EX_UNAVAILABLE" 'bundled identity realm/client bootstrap failed'
    operations_run sh -euc \
        'export EPM_POSTGRES_ADMIN_DSN="$(cat /run/secrets/epm_admin_dsn)"; exec python -m scripts.apply_postgres_migrations --expected-final-migration "$1" --expected-source-ledger "$2" --expected-source-database "$3"' \
        sh "$upgrade_target_migration" "$source_ledger" "$source_database_digest" ||
        fail "$EX_UNAVAILABLE" 'upgrade migration failed; inspect before restarting services'
    installed_database_cut=$(inspect_upgrade_schema --verify-installed) ||
        fail "$EX_UNAVAILABLE" 'upgrade target migration ledger verification failed; inspect before restarting services'
    [ "$source_database_digest" = "${installed_database_cut##* }" ] ||
        fail "$EX_UNAVAILABLE" 'installed application database differs from the source; inspect before restarting services'
    installed_ledger=${installed_database_cut% *}
    [ "${installed_ledger%% *}" = "${upgrade_target_migration%%_*}" ] ||
        fail "$EX_UNAVAILABLE" 'installed schema differs from the candidate release; inspect before restarting services'
    printf '%s\n' "installed_schema_version=${installed_ledger%% *}" \
        "installed_migration_chain_sha256=${installed_ledger#* }"
    operations_run sh -euc \
        'export EPM_POSTGRES_ADMIN_DSN="$(cat /run/secrets/epm_admin_dsn)" EPM_PG_RUNTIME_PASSWORD="$(cat /run/secrets/epm_runtime_password)" EPM_PG_ACCESS_PASSWORD="$(cat /run/secrets/epm_access_password)" EPM_PG_WORKER_PASSWORD="$(cat /run/secrets/epm_worker_password)" EPM_PG_LIFECYCLE_PASSWORD="$(cat /run/secrets/epm_lifecycle_password)" EPM_PG_PROVISION_PASSWORD="$(cat /run/secrets/epm_provision_password)" EPM_PG_SECURITY_PASSWORD="$(cat /run/secrets/epm_security_password)"; exec python -m scripts.bootstrap_postgres_service_roles' ||
        fail "$EX_UNAVAILABLE" 'upgrade service-role bootstrap failed'
    operations_run sh -euc \
        'export EPM_POSTGRES_ADMIN_DSN="$(cat /run/secrets/epm_admin_dsn)"; exec python -m scripts.bootstrap_postgres_python_coordinator --password-file /run/secrets/epm_python_coordinator_password' ||
        fail "$EX_UNAVAILABLE" 'upgrade Python-coordinator bootstrap failed'
    trap 'pause_failed_upgrade "upgrade interrupted after migration"' HUP INT TERM
    (start_upgrade_internal_services) ||
        pause_failed_upgrade 'upgraded internal services did not become healthy'
    started_runtime=$(observe_upgraded_runtime internal) ||
        pause_failed_upgrade 'restarted release identity could not be verified'
    (verify_release_health_boundaries) ||
        pause_failed_upgrade 'post-upgrade liveness, readiness, or unsigned-denial gate failed'
    internal_runtime=$(observe_upgraded_runtime internal --check-browser-gateway) ||
        pause_failed_upgrade 'healthy internal release identity could not be verified'
    [ "$internal_runtime" = "$started_runtime" ] ||
        pause_failed_upgrade 'restarted services changed during health verification'
    (start_upgrade_service worker) || pause_failed_upgrade 'upgraded worker did not become healthy'
    worker_runtime=$(observe_upgraded_runtime worker --expected-previous-running-sha256 "$internal_runtime") ||
        pause_failed_upgrade 'upgraded worker or verified internal release identity could not be verified'
    (start_upgrade_service proxy) || pause_failed_upgrade 'upgraded proxy did not become healthy'
    ready_runtime=$(observe_upgraded_runtime serving --expected-previous-running-sha256 "$worker_runtime") ||
        pause_failed_upgrade 'serving release identity could not be verified'
    (verify_release_public_ingress "$project_name" "${upgrade_source%% *}") ||
        pause_failed_upgrade 'upgraded public ingress could not be verified'
    checked_runtime=$(observe_upgraded_runtime serving --expected-previous-running-sha256 "$worker_runtime") ||
        pause_failed_upgrade 'serving release identity could not be rechecked after public ingress verification'
    [ "$ready_runtime" = "$checked_runtime" ] ||
        pause_failed_upgrade 'serving release changed during public ingress verification'
    trap - HUP INT TERM
    printf '%s\n' "installed_runtime_sha256=$ready_runtime" \
        'upgrade=complete' 'pre_upgrade_backup=verified' 'volumes=preserved'
}

install_release() {
    doctor
    require_launcher_active
    require_secret_files
    prepare_directories
    identity_mode=$(configured_identity_mode)

    operator_issuer=$(release_value EPM_PLATFORM_OPERATOR_ISSUER)
    case "$operator_issuer" in https://*) ;; *) fail "$EX_CONFIG" 'a verified HTTPS EPM_PLATFORM_OPERATOR_ISSUER is required' ;; esac

    if [ -n "$(compose_call ps --status running -q 2>/dev/null)" ]; then
        install_started_services=0
    else
        install_started_services=1
    fi
    pull_release_images || install_failed 'immutable release image pull failed'
    validate_browser_gateway_configuration
    compose_call up -d --wait --wait-timeout 180 db control-db ||
        install_failed 'database services did not become healthy'
    compose_call --profile operations run --rm -T control-bootstrap ||
        install_failed 'isolated control-plane database bootstrap failed'
    compose_call --profile bundled-identity up -d --wait --wait-timeout 300 identity ||
        install_failed 'bundled identity service did not become healthy'
    keycloak_bootstrap_output=$(compose_call --profile bundled-identity run --rm -T \
        keycloak-bootstrap) ||
        install_failed 'bundled identity realm/client bootstrap failed'
    operator_subject=$(keycloak_initial_subject "$keycloak_bootstrap_output") ||
        install_failed 'bundled identity bootstrap returned an invalid initial administrator subject'
    operations_run sh -euc \
        'export EPM_POSTGRES_ADMIN_DSN="$(cat /run/secrets/epm_admin_dsn)"; exec python -m scripts.apply_postgres_migrations' ||
        install_failed 'controlled database migration failed'
    operations_run sh -euc \
        'export EPM_POSTGRES_ADMIN_DSN="$(cat /run/secrets/epm_admin_dsn)" EPM_PG_RUNTIME_PASSWORD="$(cat /run/secrets/epm_runtime_password)" EPM_PG_ACCESS_PASSWORD="$(cat /run/secrets/epm_access_password)" EPM_PG_WORKER_PASSWORD="$(cat /run/secrets/epm_worker_password)" EPM_PG_LIFECYCLE_PASSWORD="$(cat /run/secrets/epm_lifecycle_password)" EPM_PG_PROVISION_PASSWORD="$(cat /run/secrets/epm_provision_password)" EPM_PG_SECURITY_PASSWORD="$(cat /run/secrets/epm_security_password)"; exec python -m scripts.bootstrap_postgres_service_roles' ||
        install_failed 'controlled service-role bootstrap failed'
    operations_run sh -euc \
        'export EPM_POSTGRES_ADMIN_DSN="$(cat /run/secrets/epm_admin_dsn)"; exec python -m scripts.bootstrap_postgres_python_coordinator --password-file /run/secrets/epm_python_coordinator_password' ||
        install_failed 'controlled Python-coordinator bootstrap failed'
    operations_run sh -euc \
        'export EPM_POSTGRES_ADMIN_DSN="$(cat /run/secrets/epm_admin_dsn)"; exec python -m scripts.bootstrap_postgres_operator --issuer "$1" --subject-id "$2"' \
        openepm-bootstrap "$operator_issuer" "$operator_subject" ||
        install_failed 'controlled platform-operator bootstrap failed'
    start_current_release ||
        install_failed 'release services did not become healthy'
    verify_release_health_boundaries ||
        install_failed 'liveness, readiness, or unsigned-denial gate failed'
    printf '%s\n' 'install=complete' 'volumes=preserved' \
        'liveness=verified' 'readiness=verified' \
        'unsigned_access=denied'
}

uninstall_release() {
    require_release_config
    compose_call stop
    compose_call rm -f
    printf '%s\n' 'uninstall=services-removed' 'volumes=preserved'
}

doctor_local() {
    arch=$(architecture)
    require_compose
    require_command runsc
    runsc --version >/dev/null 2>&1 || fail "$EX_CONFIG" 'gVisor runsc is not executable'
    require_release_config
