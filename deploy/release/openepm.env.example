# This file is a shape template, not usable credentials or a qualified release.
EPM_PLATFORM=linux/amd64
EPM_IDENTITY_MODE=bundled
EPM_NOTEBOOK_MODE=disabled
# Production fails closed for `none`. In deployment-volume mode, list every
# persistent host path after the operator has provisioned it on active LUKS/
# dm-crypt storage. epmctl verifies; it never formats or changes a device.
EPM_ENCRYPTION_AT_REST_MODE=none
EPM_ENCRYPTED_VOLUME_PATHS=
EPM_APPLICATION_IMAGE=registry.example.invalid/openepm/application@sha256:REPLACE
EPM_DATABASE_IMAGE=registry.example.invalid/openepm/database@sha256:REPLACE
EPM_OPERATIONS_IMAGE=registry.example.invalid/openepm/operations@sha256:REPLACE
EPM_BUILDER_IMAGE=registry.example.invalid/openepm/builder@sha256:REPLACE
EPM_NOTEBOOK_IMAGE=registry.example.invalid/openepm/notebook@sha256:REPLACE
EPM_HUB_IMAGE=registry.example.invalid/openepm/hub@sha256:REPLACE
EPM_IDENTITY_IMAGE=registry.example.invalid/openepm/keycloak@sha256:REPLACE
EPM_PROXY_IMAGE=docker.io/library/traefik:v3.7.16@sha256:1336e85aaed293bd63d005086e0dd013b04078b26aaeb1c18b26a2f928af7e65
EPM_BROWSER_GATEWAY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy@sha256:REPLACE
EPM_BROWSER_SESSION_STORE_IMAGE=docker.io/valkey/valkey@sha256:REPLACE
# Release resource ceilings. These defaults are starting bounds, not capacity
# claims; freeze and qualify any changes with the exact candidate workload.
EPM_CORE_MEMORY_LIMIT=2g
EPM_TELEMETRY_MEMORY_LIMIT=512m
EPM_TELEMETRY_CPU_LIMIT=1.0
EPM_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib@sha256:REPLACE_WITH_QUALIFIED_DIGEST
EPM_CORE_CPU_LIMIT=2.0
EPM_DATABASE_MEMORY_LIMIT=4g
EPM_DATABASE_CPU_LIMIT=4.0
EPM_PROXY_MEMORY_LIMIT=256m
EPM_PROXY_CPU_LIMIT=1.0
EPM_SESSION_STORE_MEMORY_LIMIT=512m
EPM_SESSION_STORE_CPU_LIMIT=1.0
EPM_BROWSER_GATEWAY_MEMORY_LIMIT=256m
EPM_BROWSER_GATEWAY_CPU_LIMIT=1.0
EPM_OPERATIONS_MEMORY_LIMIT=1g
EPM_OPERATIONS_CPU_LIMIT=2.0
EPM_IDENTITY_PID_LIMIT=512
EPM_IDENTITY_MEMORY_LIMIT=2g
EPM_IDENTITY_CPU_LIMIT=2.0
EPM_BOOTSTRAP_PID_LIMIT=128
EPM_BOOTSTRAP_MEMORY_LIMIT=512m
EPM_BOOTSTRAP_CPU_LIMIT=1.0
EPM_HUB_PID_LIMIT=512
EPM_HUB_MEMORY_LIMIT=1g
EPM_HUB_CPU_LIMIT=2.0
EPM_SECRETS_DIR=/etc/openepm/secrets
EPM_TLS_DIR=/etc/openepm/tls
# A staged replacement certificate set must remain valid for at least this
# window before epmctl will stop services and promote it.
EPM_CERTIFICATE_MINIMUM_VALIDITY_SECONDS=604800
EPM_PROXY_CONFIG_DIR=/etc/openepm/proxy
EPM_PUBLIC_HOST=epm.example.invalid
EPM_IDENTITY_PUBLIC_HOST=identity.example.invalid
EPM_OIDC_ISSUER=https://identity.example.invalid/realms/openepm
EPM_OIDC_JWKS_URL=https://identity:8443/realms/openepm/protocol/openid-connect/certs
EPM_OIDC_AUD_MCP=openepm-mcp
EPM_OIDC_AUD_WEB=openepm-web
# Retained only for bounded historical pilot compatibility. The portable
# bundled profile rejects it and requires internal HTTPS plus its private CA.
EPM_OIDC_ALLOW_INTERNAL_HTTP_JWKS=
EPM_KEYCLOAK_DIRECTORY_URL=https://identity:8443
# Optional fixed-workspace MCP listener. Leave empty until the first workspace
# exists; start it explicitly with the "workspace" Compose profile afterward.
EPM_PG_WORKSPACE_ID=
EPM_BACKUP_EXPORT_DIR=/var/lib/openepm/export

# Files required beneath EPM_SECRETS_DIR for isolated Python builds:
# - epm_python_coordinator_dsn: DSN for the epm_python_coordinator-only login
# - epm_python_build_capability_key: at least 32 random binary bytes
# - epm_python_builder_profiles.json: administrator-approved immutable image
#   profiles; never put database credentials, refresh tokens or Docker options
#   in this document.
# - epm_sandbox_control_key: at least 32 random binary bytes, shared only with
#   the host launcher and the fixed-core worker.
EPM_SANDBOX_SOCKET_DIR=/run/openepm-sandbox

# Managed notebooks are launched per verified OIDC subject by the trusted host
# launcher. The base domain requires wildcard DNS and TLS before public use.
# EPM_SECRETS_DIR must also contain notebook_control_key with at least 32
# random bytes and a separate hub_oidc_client_secret. The control key is
# shared only by Hub and the trusted notebook launcher.
EPM_NOTEBOOK_PROFILE_ID=openepm-notebook-v1
EPM_NOTEBOOK_BASE_DOMAIN=notebooks.example.invalid
EPM_NOTEBOOK_MAX_ACTIVE=10
EPM_NOTEBOOK_IDLE_SECONDS=1800
EPM_NOTEBOOK_SOCKET_DIR=/run/openepm
EPM_NOTEBOOK_NETWORK_NAME=openepm_notebook
EPM_HUB_PUBLIC_URL=https://notebooks.example.invalid
EPM_HUB_OIDC_ISSUER=https://identity.example.invalid/realms/openepm
EPM_HUB_OIDC_CLIENT_ID=openepm-jupyterhub
EPM_HUB_OIDC_AUTHORIZE_URL=https://identity.example.invalid/realms/openepm/protocol/openid-connect/auth
EPM_HUB_OIDC_TOKEN_URL=https://identity.example.invalid/realms/openepm/protocol/openid-connect/token
EPM_HUB_OIDC_USERINFO_URL=https://identity.example.invalid/realms/openepm/protocol/openid-connect/userinfo

# The installer binds the exact initial native administrator subject returned
# by bundled Keycloak bootstrap; an operator must not transcribe or guess it.
EPM_PLATFORM_OPERATOR_ISSUER=https://identity.example.invalid/realms/openepm

# keycloak_bootstrap_config.json is required beneath EPM_SECRETS_DIR for the
# bundled identity profile. Start from keycloak-bootstrap.example.json and list
# only exact loopback callback ports supported by deployed MCP clients.
# The same directory profile also requires keycloak_directory_client_secret:
# at least 32 random bytes shared only by the bootstrap job and platform
# directory adapter. Never reuse the Keycloak bootstrap-administrator password.
# The confidential browser-session gateway requires a distinct
# keycloak_web_client_secret of at least 32 random bytes, shared only by the
# Keycloak bootstrap and the browser gateway.
# Bundled identity also requires keycloak_internal_tls_certificate,
# keycloak_internal_tls_private_key and keycloak_internal_ca_certificate.
# The certificate must identify the internal DNS name `identity`; the CA file
# is mounted only into callers that communicate with the bundled service.
# The protected secrets directory must also contain browser_gateway.cfg,
# browser_gateway_alpha.yaml and browser_session_store.conf. The alpha config
# routes `/` to `web:5195` and rewrites `/api/platform/browser/` to
# `platform:5193/browser/`; the session store must require a distinct password.
# Open EPM uses native Keycloak usernames and administrator-issued temporary
# passwords. Google brokering, SMTP verification and self-service password
# recovery are intentionally absent from the supported profile.
# epm_python_coordinator_password is a distinct 24+-character protected
# credential. Its matching epm_python_coordinator_dsn is mounted only into the
# worker and Python-build broker; installation and restoration create the
# least-privilege login through the fixed bootstrap command.
