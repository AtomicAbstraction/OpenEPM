# Copy to a private .env file outside source control; set chmod 600.
EPM_POSTGRES_PASSWORD=
EPM_PG_RUNTIME_PASSWORD=
EPM_PG_ACCESS_PASSWORD=
EPM_PG_WORKER_PASSWORD=
EPM_PG_LIFECYCLE_PASSWORD=
EPM_PG_PROVISION_PASSWORD=
EPM_PG_SECURITY_PASSWORD=
EPM_PG_PREVIEW_SECRET_HEX=
# Keycloak/OIDC is the sole production identity authority.
EPM_AUTH_MODE=oidc
EPM_OIDC_ISSUER=https://identity.example.com/realms/openepm
EPM_OIDC_JWKS_URL=https://identity.example.com/realms/openepm/protocol/openid-connect/certs
EPM_OIDC_AUD_MCP=openepm-mcp
EPM_OIDC_AUD_WEB=openepm-web
EPM_PUBLIC_WEB_ORIGIN=
EPM_PUBLIC_MCP_ORIGIN=
EPM_PLATFORM_OPERATOR_ISSUER=
EPM_PLATFORM_OPERATOR_SUBJECT=
EPM_PG_WORKSPACE_ID=
# Optional JSON deployment declaration for reset preview; not proof of coverage.
EPM_RESET_ENDPOINT_INVENTORY_JSON=
